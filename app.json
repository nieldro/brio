{
  "expo": {
    "name": "brío",
    "slug": "brio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "brio",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131A2E",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F2604C",
          "defaultChannel": "brio"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Brío usa la cámara para tu foto del día y para mirar tu plato. Las fotos del álbum se quedan en este teléfono.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Brío pide tus fotos solo para que puedas elegir una del plato que quieras mostrarle.",
          "cameraPermission": "Brío usa la cámara para la foto de tu plato."
        }
      ]
    ]
  }
}
