{
  "expo": {
    "name": "brío",
    "slug": "brio",
    "owner": "nieldro",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "brio",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131A2E",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielpaez.brio"
    },
    "android": {
      "package": "com.danielpaez.brio",
      "adaptiveIcon": {
        "backgroundColor": "#131A2E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F2604C",
          "defaultChannel": "brio"
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Brío usa la cámara para tu foto del día y para mirar tu plato. Las fotos del álbum se quedan en este teléfono.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Brío pide tus fotos solo para que puedas elegir una del plato que quieras mostrarle.",
          "cameraPermission": "Brío usa la cámara para la foto de tu plato."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Brío usa el podómetro para acompañar tus caminatas. No hay meta que cumplir y la cuenta no sale de tu teléfono."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9d23c3c3-5336-4885-a8dc-b8a6df4d08e1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9d23c3c3-5336-4885-a8dc-b8a6df4d08e1"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
