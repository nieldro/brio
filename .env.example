# Copia este archivo como .env y pega tus valores.
# .env está en .gitignore: nunca se sube al repositorio.
#
# Dónde salen: Supabase > tu proyecto > Project Settings > API
#
# EXPO_PUBLIC_ significa que el valor viaja dentro de la app.
# Por eso aquí SOLO va la clave anon, que es pública por diseño y está
# protegida por Row Level Security. La service_role y la key de Gemini
# NUNCA van aquí: viven en Application Settings de la Azure Function App.

EXPO_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anon

# URL de la Function App, sin barra final ni /api.
# Local con Azure Functions Core Tools: http://localhost:7071
EXPO_PUBLIC_API_URL=https://brio-functions.azurewebsites.net
